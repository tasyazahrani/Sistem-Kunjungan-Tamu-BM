# ==== Tambahkan/sesuaikan baris berikut di file .env proyek Laravel Anda ====

APP_NAME="SIMANTAP Bener Meriah"
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simantap_bm
DB_USERNAME=root
DB_PASSWORD=

# Locale Bahasa Indonesia untuk format tanggal (opsional, butuh package spatie/laravel-translation-loader
# TIDAK wajib — Carbon->translatedFormat() sudah otomatis berfungsi jika App::setLocale('id') diaktifkan)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
